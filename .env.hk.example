# Copy to .env.hk on the Hong Kong server (never commit real values)

# Prefer sharing the same Neon/Postgres as Vercel, so login/comments stay in sync
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

AUTH_SECRET="same-as-vercel-or-new-long-random"
NEXTAUTH_SECRET="same-as-vercel-or-new-long-random"

# Must match the public Hong Kong URL (no trailing slash).
# Use http://IP:3000 until HTTPS is configured; Secure cookies follow this scheme.
NEXTAUTH_URL="http://47.238.229.208:3000"

# Optional override: force Secure cookies on/off (defaults from NEXTAUTH_URL scheme)
# COOKIE_SECURE="false"

# Optional: GitHub OAuth for admin. Add the HK callback URL in GitHub App settings:
# https://hk.your-domain.com/api/auth
GITHUB_ID=""
GITHUB_SECRET=""
