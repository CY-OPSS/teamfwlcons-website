# Database (必填：用于全站共享的注册/评论)
# 推荐免费 Neon：https://console.neon.tech
# 或在 Vercel 项目里创建 Postgres / 接入 Neon
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session / Auth
# 生产环境必填，且长度 >= 32；缺失或过短时服务端会拒绝签发/校验会话
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="请换成一串随机长字符串"
NEXTAUTH_SECRET="请换成一串随机长字符串"
NEXTAUTH_URL="http://localhost:3000"

# 管理后台
# 写入仓库用的细粒度 Token（仅服务端读取，不要暴露给浏览器）
# Repository access = 仅 teamfwlcons-website
# Permissions → Contents: Read and write
GITHUB_CONTENT_TOKEN=""

# Vercel Deploy Hook 地址（含密钥）。只在服务端读取，绝不要写进 src/。
# Vercel → 项目 → Settings → Git → Deploy Hooks 生成
VERCEL_DEPLOY_HOOK=""

# 后台内容仓库，默认 CY-OPSS/teamfwlcons-website
ADMIN_REPO="CY-OPSS/teamfwlcons-website"

# 可选：后台登录白名单（GitHub 用户名，逗号分隔）。
# 留空 = 任何对该仓库有写权限的 Token 均可登录。
# 例：ADMIN_GITHUB_USERS="CY-OPSS,facwink"
ADMIN_GITHUB_USERS=""

# 可选：强制指定会话 Cookie 是否带 Secure（默认按 NEXTAUTH_URL 的协议推断）
# COOKIE_SECURE="true"
