# Database (必填：用于全站共享的注册/评论)
# 推荐免费 Neon：https://console.neon.tech
# 或在 Vercel 项目里创建 Postgres / 接入 Neon
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session / Auth
AUTH_SECRET="请换成一串随机长字符串"
NEXTAUTH_SECRET="请换成一串随机长字符串"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (仅 CMS 管理后台可选)
GITHUB_ID="your-github-id"
GITHUB_SECRET="your-github-secret"
